# Optional: a server-side OpenRouter API key used as a fallback when a visitor
# has not entered their own key in the UI. Get one at https://openrouter.ai/keys
#
# Leave this unset if you want every visitor to bring their own key
# (recommended for a public deployment).
OPENROUTER_API_KEY=

# Optional: shown to OpenRouter for attribution / rankings. Set to your
# deployed URL, e.g. https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=
